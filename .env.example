# Copy to .env.local (never committed) and fill in. Without TMDB_TOKEN the site shows the labelled fictional sample data.
# TMDB "API Read Access Token" from https://www.themoviedb.org/settings/api (non-commercial use only).
TMDB_TOKEN=
# MyAnimeList Client ID from MAL profile settings -> API (server-side only; keep secret).
MAL_CLIENT_ID=
# Public address of the deployed site, used for the sitemap and links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
